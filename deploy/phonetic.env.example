# /etc/phonetic/env: phonetic's settings and secrets (root-only: chmod 600).
# `phonetic -h` lists every variable. PHONETIC_DATA_DIR is set by the unit.

# Secrets: generate each with `openssl rand -base64 24`.
PHONETIC_API_TOKEN=
PHONETIC_FEED_PASSWORD=

# Where to listen, and the URL your phone uses to reach it. Uncomment one
# pair:
#
# Tailscale, with `tailscale serve --bg 8080` providing HTTPS:
# PHONETIC_ADDR=127.0.0.1:8080
# PHONETIC_PUBLIC_URL=https://HOSTNAME.TAILNET.ts.net
#
# WireGuard (or a Tailscale IP) directly, plain HTTP inside the tunnel:
# PHONETIC_ADDR=10.8.0.1:8080
# PHONETIC_PUBLIC_URL=http://10.8.0.1:8080

# Your home's public IPv4 address: routers often serve their admin page on
# it, and pages must not be able to make phonetic fetch it.
PHONETIC_FETCH_BLOCKED=
